<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Runs the full suite against Chrome, Firefox and Edge in parallel.
  Usage: mvn test -Dsuite=testng-cross-browser.xml
-->
<suite name="Swift Cross-Browser Suite" parallel="tests" thread-count="3" verbose="1">

    <listeners>
        <listener class-name="com.swift.framework.listeners.TestListener"/>
        <listener class-name="com.swift.framework.listeners.RetryListener"/>
    </listeners>

    <test name="Chrome">
        <parameter name="browser" value="chrome"/>
        <parameter name="executionMode" value="local"/>
        <classes>
            <class name="com.swift.tests.HomePageTests"/>
            <class name="com.swift.tests.CareersPageTests"/>
            <class name="com.swift.tests.BrokenLinksTest"/>
            <class name="com.swift.tests.ImageCountTest"/>
        </classes>
    </test>

    <test name="Firefox">
        <parameter name="browser" value="firefox"/>
        <parameter name="executionMode" value="local"/>
        <classes>
            <class name="com.swift.tests.HomePageTests"/>
            <class name="com.swift.tests.CareersPageTests"/>
            <class name="com.swift.tests.BrokenLinksTest"/>
            <class name="com.swift.tests.ImageCountTest"/>
        </classes>
    </test>

    <test name="Edge">
        <parameter name="browser" value="edge"/>
        <parameter name="executionMode" value="local"/>
        <classes>
            <class name="com.swift.tests.HomePageTests"/>
            <class name="com.swift.tests.CareersPageTests"/>
            <class name="com.swift.tests.BrokenLinksTest"/>
            <class name="com.swift.tests.ImageCountTest"/>
        </classes>
    </test>
</suite>
